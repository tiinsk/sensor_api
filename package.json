{
  "name": "api",
  "version": "1.0.0",
  "description": "Sensor API",
  "main": "server.ts",
  "scripts": {
    "start:production": "NODE_ENV=production node ./dist/server.js",
    "start": "./node_modules/nodemon/bin/nodemon.js -e ts  --exec \"npm run compile\"",
    "compile": "tsc && NODE_ENV=development node ./dist/server.js",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:setup": "knex migrate:latest && knex seed:run",
    "test:start": "NODE_ENV=development node ./dist/server.js"
  },
  "author": "Tiina Koskiranta",
  "license": "ISC",
  "dependencies": {
    "@hapi/hapi": "^21.3.2",
    "boom": "^7.3.0",
    "hapi-jsonwebtoken": "^1.1.0",
    "joi": "^17.11.0",
    "knex": "^3.0.1",
    "luxon": "^3.4.4",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.9.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^30.2.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.2"
  }
}
